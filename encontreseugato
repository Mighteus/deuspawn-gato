function parseNames(t){
  const out=[];let m;const re=/instagram\.com\/(?:_u\/)?([A-Za-z0-9._]{1,30})/g;
  while((m=re.exec(t)))out.push(m[1]);
  if(!out.length){
    const j=[...t.matchAll(/"value"\s*:\s*"([^"]+)"/g)].map(x=>x[1]);
    out.push(...(j.length?j:t.split(/[\n,;\t ]+/)));
  }
  return out.map(s=>s.replace(/^@/,'').trim()).filter(Boolean);
}
