const NPR=400,beds=[],bowls=[],bcols=[0xf7a8c4,0xb9a6f2,0x8fe3c0,0xffc79a].map(h=>new T.Color(h));let autoB=0,autoW=0;
const bedRimM=inst(new T.TorusGeometry(.62,.2,8,20).rotateX(Math.PI/2).translate(0,.2,0),0,NPR,1),bedPadM=inst(new T.CylinderGeometry(.66,.66,.2,20).translate(0,.1,0),0xfff0e0,NPR),
  bowlM=inst(new T.CylinderGeometry(.34,.26,.2,16,1,true).translate(0,.1,0),0x5aa9e6,NPR),waterM=inst(new T.CircleGeometry(.3,16).rotateX(-Math.PI/2).translate(0,.15,0),0x8fe8ff,NPR);
bowlM.material.side=T.DoubleSide;
function addProp(arr,ms,x,z){
  if(arr.length>=NPR)return;const i=arr.length;arr.push({x,z});dirty=true;saveT=1.5;
  v3.set(x,0,z);vs.set(1,1,1);tm.compose(v3,qI,vs);ms.forEach(m=>{tm.toArray(m.instanceMatrix.array,i*16);m.count=arr.length;m.instanceMatrix.needsUpdate=true});
  return i;
}
function addBed(x,z,a){const i=addProp(beds,[bedRimM,bedPadM],x,z);if(i!=null){beds[i].a=a;bedRimM.setColorAt(i,bcols[i%4]);bedRimM.instanceColor.needsUpdate=true}}
function addBowl(x,z,a){const i=addProp(bowls,[bowlM,waterM],x,z);if(i!=null)bowls[i].a=a}
function clearProps(){beds.length=bowls.length=0;autoB=autoW=0;[bedRimM,bedPadM,bowlM,waterM].forEach(m=>m.count=0)}
function spot(){let x=tg.x+(rnd()-.5)*4,z=tg.z+(rnd()-.5)*4;const m=Math.hypot(x,z),L=R-3;if(m>L){x*=L/m;z*=L/m}return{x,z}}
function pickGoal(u){
  const bed=Math.random()<.5,A=bed?beds:bowls;let b=null,bd=256;
  for(const p of A){if(p.by)continue;const dx=p.x-u.x,dz=p.z-u.z,d=dx*dx+dz*dz;if(d<bd){bd=d;b=p}}
  if(b){b.by=u;u.gt=20;u.goal={x:b.x,z:b.z+(bed?0:.9*u.s),bed,p:b}}
}
function startCine(){if(cine){stopCam();return}cine={t:0}}
function extras(dt,t){
  const want=Math.min(80,Math.floor(R/2.5));
  while(autoB<want){const a=rnd()*6.28,r=Math.sqrt(rnd())*R*.88;addBed(Math.sin(a)*r,Math.cos(a)*r,1);autoB++}
  while(autoW<want){const a=rnd()*6.28,r=Math.sqrt(rnd())*R*.88;addBowl(Math.sin(a)*r,Math.cos(a)*r,1);autoW++}
  if(dirty&&(saveT-=dt)<=0){dirty=false;save()}
  if(queue.length){spawnAcc+=dt*qrate;let k=Math.floor(spawnAcc);spawnAcc-=k;while(k-->0&&queue.length){const q=queue.shift();makeCat(Object.assign({},q,{drop:true,h:12}))}if(!queue.length)save()}
  night+=(nightT-night)*Math.min(1,dt*1.5);
  scene.background.copy(dayC).lerp(nightC,night);scene.fog.color.copy(scene.background);
  hemi.intensity=.95-.6*night;sun.intensity=.8-.65*night;
  stars.visible=moon.visible=night>.15;stars.material.opacity=night;stars.position.copy(cam.position);moon.position.set(cam.position.x+500,cam.position.y+700,cam.position.z-1200);
  if(wk){const v=wk===1?32:3.5,P=wg.attributes.position.array;for(let i=0;i<NP;i++){let y=P[i*3+1]-v*dt;if(y<0)y+=60;P[i*3+1]=y;if(wk===2)P[i*3]+=Math.sin(t+i)*dt*.8}wg.attributes.position.needsUpdate=true;wp.position.set(tg.x,0,tg.z);wp.scale.setScalar(Math.max(1,rad/30))}
  const m=Math.floor(cats.length/100);if(m>lastMil){confetti();toast('🎉 '+m*100+' gatinhos!')}lastMil=m;
  if(cft>0){cft-=dt;const P=cgm.attributes.position.array,gk=Math.max(1,rad/30);for(let i=0;i<CN;i++){cvl[i*3+1]-=25*dt*gk;for(let k=0;k<3;k++)P[i*3+k]+=cvl[i*3+k]*dt}cgm.attributes.position.needsUpdate=true;cf.material.opacity=Math.min(1,cft)}else cf.visible=false;
  if(follow&&!tour){meowT-=dt;if(meowT<=0){meowT=4+rnd()*4;meow();bubT=1.3;bub.material.map=tagTex('miau!')}}
  if(bubT>0&&follow&&!tour){bubT-=dt;const w=Math.max(2.4,rad*.09);bub.visible=true;bub.scale.set(w,w/4,1);bub.position.set(follow.x,follow.y+2.9*follow.s+w*.15,follow.z)}else bub.visible=false;
  if(cine&&(cine.t-=dt)<=0){
    cine.t=5+rnd()*3;
    if(rnd()<.4||!cats.length){follow=null;tour=null;fit=true;ph=.7+rnd()*.5;showCam()}
    else{fit=false;rad=8+rnd()*10;ph=.9+rnd()*.5;auto=true;follow=cats[rnd()*cats.length|0];tour=null;showCam()}
  }
}
const sdlg=document.getElementById('sdlg'),si=document.getElementById('si'),slist=document.getElementById('slist');
function renderS(){
  const q=si.value.trim().replace(/^@/,'').toLowerCase(),named=cats.filter(c=>c.name);
  const out=q?named.filter(c=>c.name.toLowerCase().includes(q)).slice(0,8):(named.length>10?[...named.slice(0,5),...named.slice(-5)]:named);
  slist.innerHTML='';
  out.forEach(c=>{const b=document.createElement('button');b.textContent=(q?'':(named.indexOf(c)<5?'🏆 ':'🆕 '))+c.name;b.onclick=()=>{sdlg.hidden=true;startFollow(c)};slist.appendChild(b)});
  if(!out.length)slist.textContent=q?'Nenhum seguidor encontrado.':'Importe seguidores primeiro.';
}
si.oninput=renderS;setTimeout(()=>{if(!document.body.classList.contains('admin')){si.value='';renderS();sdlg.hidden=false}},2000);
const ldlg=document.getElementById('ldlg');let lpg=0;
function renderL(){
  const items=[...cats.filter(c=>c.name),...queue],per=50,pages=Math.max(1,Math.ceil(items.length/per));
  lpg=Math.min(Math.max(lpg,0),pages-1);
  document.getElementById('lp').textContent=items.length+' seguidores. Página '+(lpg+1)+' de '+pages+'. Ordem da lista: do mais antigo ao mais novo.';
  const ll=document.getElementById('llist');ll.innerHTML='';
  items.slice(lpg*per,lpg*per+per).forEach((c,k)=>{
    const b=document.createElement('button'),n=lpg*per+k+1;
    if(c.x!==undefined){b.textContent=n+'. '+c.name+(n===1?' 👑':'');b.onclick=()=>{ldlg.hidden=true;startFollow(c)}}
    else{b.textContent=n+'. '+c.name+' (na fila)';b.disabled=true;b.style.opacity=.55}
    ll.appendChild(b);
  });
}
document.getElementById('lpv').onclick=()=>{lpg--;renderL()};
document.getElementById('lnx').onclick=()=>{lpg++;renderL()};
document.getElementById('lcl').onclick=()=>{ldlg.hidden=true};document.getElementById('sc').onclick=()=>{sdlg.hidden=true};
function copyWorld(){
  const d=[...cats.map(c=>[c.name||null,c.f,...c.o]),...queue.map(q=>[q.name,q.fur,...(q.o||[0,0,0,0,0])])];
  const pr={b:beds.map(p=>[+p.x.toFixed(2),+p.z.toFixed(2),p.a?1:0]),w:bowls.map(p=>[+p.x.toFixed(2),+p.z.toFixed(2),p.a?1:0])};
  const txt='window.SNAP='+JSON.stringify(d)+';window.SNAPP='+JSON.stringify(pr)+';';
  const show=()=>{ta.value=txt;msg.textContent='Copie todo o texto abaixo e envie para o Claude.';document.getElementById('go').disabled=true;dlg.hidden=false;ta.select()};
  if(navigator.clipboard)navigator.clipboard.writeText(txt).then(()=>toast('📋 Copiado! Cole no chat com o Claude'),show);else show();
}
function save(){return;try{localStorage.setItem('gatos',JSON.stringify([...cats.map(c=>[c.name||null,c.f,...c.o]),...queue.map(q=>[q.name,q.fur,...(q.o||[0,0,0,0,0])])]));localStorage.setItem('gatos_props',JSON.stringify({b:beds.map(p=>[+p.x.toFixed(2),+p.z.toFixed(2),p.a?1:0]),w:bowls.map(p=>[+p.x.toFixed(2),+p.z.toFixed(2),p.a?1:0])}))}catch(e){}}
let saved=window.SNAP||[];
if(saved.length){R=Math.max(R,Math.sqrt(saved.length)*3.2);const h=Math.min(120,saved.length/15);saved.forEach(s=>s[0]&&names.add(String(s[0]).toLowerCase()));queue.push(...saved.map(s=>({name:s[0]?String(s[0]):null,fur:s[1],scale:s[2]||0,speed:s[3]||0,jump:s[4]||0,jv:s[5]||0,rainbow:!!s[6]})));qrate=1e9}else many(3,{});
try{const pr=(window.SNAPP||null);if(pr){pr.b.forEach(p=>{addBed(p[0],p[1],p[2]);if(p[2])autoB++});pr.w.forEach(p=>{addBowl(p[0],p[1],p[2]);if(p[2])autoW++})}}catch(e){}
let ART=null;
async function publishWorld(){
  if(!ART)return;
  const d=[...cats.map(c=>[c.name||null,c.f,...c.o]),...queue.map(q=>[q.name,q.fur,...(q.o||[0,0,0,0,0])])];
  const pr={b:beds.map(p=>[+p.x.toFixed(2),+p.z.toFixed(2),p.a?1:0]),w:bowls.map(p=>[+p.x.toFixed(2),+p.z.toFixed(2),p.a?1:0])};
  const c=SRC0.cloneNode(true);
  c.querySelector('#snap').textContent=('window.SNAP='+JSON.stringify(d)+';window.SNAPP='+JSON.stringify(pr)+';').replace(/</g,'\\u003c');
  try{toast('Publicando...');await ART.publish('<!DOCTYPE html>\n'+c.outerHTML)}catch(e){toast('Não deu para publicar ('+(e&&e.code||'erro')+')')}
}
(async()=>{try{
  if(!window.claude)return;
  const u=await claude.use('user'),a=await claude.use('artifact');
  if(u&&a&&(u.isOwner()||u.canEdit())){ART=a;document.body.classList.add('admin');add('💾 Publicar mundo',publishWorld,true)}
}catch(e){}})();
const clock=new T.Clock();
(function loop(){
  const dt=Math.min(clock.getDelta(),.05),t=clock.elapsedTime;
  if(auto)th+=dt*.06;
  if(fit)rad+=((R*1.7+8)-rad)*Math.min(1,dt*1.5);
  if(tour&&(tour.t-=dt)<=0){
    const n=cats.length;
    if(!n)tour=null;
    else{
      follow=cats[Math.min(tour.i,n-1)];tour.t=.35;
      if(tour.i>=n-1){tour=null}else tour.i=Math.min(n-1,tour.i+Math.max(1,Math.ceil(n/60)));
      showCam();
    }
  }
  Ls+=(R+14-Ls)*Math.min(1,dt*4);grass.scale.set(Ls,1,Ls);sand.scale.set(Ls+5,1,Ls+5);
  clouds.rotation.y+=dt*.004;wtex.offset.x+=dt*.003;wtex.offset.y+=dt*.0015;
  trM.count=c1M.count=c2M.count=Math.min(NT,Math.max(0,Math.floor(((R+9)/4.6)**2-3)));
  placeCam(dt);scene.fog.near=rad*.9+60;scene.fog.far=rad*3+400;
  extras(dt,t);
  const n=cats.length,p=cam.position;labs.length=0;
  for(let i=0;i<n;i++)upd(cats[i],i,dt,t,p.x,p.y,p.z);
  [[bodyM,1],[headM,1],[tailM,1],[shM,1],[tipM,1],[muzM,1],[noseM,1],[whM,1],[chestM,1],[patM,1],[earInM,2],[eyeHM,2],[pawM,4],[hatM,1],[crownM,1],[bowM,1],[earM,2],[eyeM,2],[legM,4]].forEach(a=>{
    const m=a[0];m.count=n*a[1];m.instanceMatrix.updateRange.count=m.count*16;m.instanceMatrix.needsUpdate=true;
  });
  if(colDirty){furM.forEach(m=>{m.instanceColor.needsUpdate=true});colDirty=false}
  labs.sort((a,b)=>a.d-b.d);labTh=labs.length>=pool.length?Math.min(160000,labs[pool.length-1].d*1.4+1):160000;
  for(let k=0;k<pool.length;k++){
    const sp=pool[k],l=labs[k];
    if(l){const u=l.u,z=Math.min(1.6,Math.max(.7,u.s)),w=Math.max(3.2*z,Math.sqrt(l.d)*.06),h=w*.25;sp.visible=true;sp.material.map=tagTex(u.name);sp.scale.set(w,h,1);sp.position.set(u.x,u.y+1.9*u.s+h*.5,u.z)}
    else sp.visible=false;
  }
  renderer.render(scene,cam);requestAnimationFrame(loop);
})();
